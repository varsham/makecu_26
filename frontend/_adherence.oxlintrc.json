{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/calendar/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/pills/**",
              "ui_kits/sprout-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fredoka|Figtree|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Fredoka, Figtree, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:leaf|rose|sky|apricot|honey|mauve|neutral)$/]",
        "message": "<Badge> tone must be one of 'leaf' | 'rose' | 'sky' | 'apricot' | 'honey' | 'mauve' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'soft' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarDayInfo'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dots|paused|key|ref|className|style|children)$/]",
        "message": "<CalendarDayInfo> doesn't accept that prop. Declared props: tone, dots, paused."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|padding|elevated|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, padding, elevated, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|paper|oat|tan|honey|mauve|leaf|rose|sky|apricot)$/]",
        "message": "<Card> tone must be one of 'white' | 'paper' | 'oat' | 'tan' | 'honey' | 'mauve' | 'leaf' | 'rose' | 'sky' | 'apricot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompartmentTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|color|size|key|ref|className|style|children)$/]",
        "message": "<CompartmentTag> doesn't accept that prop. Declared props: number, color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompartmentTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<CompartmentTag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|size|key|ref|className|style|children)$/]",
        "message": "<DayPicker> doesn't accept that prop. Declared props: value, onChange, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|soft|solid|card)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'soft' | 'solid' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|unit|size|key|ref|className|style|children)$/]",
        "message": "<NumberStepper> doesn't accept that prop. Declared props: value, min, max, step, onChange, unit, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberStepper'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<NumberStepper> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|dose|category|categoryColor|categoryTone|compartment|count|total|lowAt|outAt|schedule|paused|onClick|key|ref|className|style|children)$/]",
        "message": "<PillCard> doesn't accept that prop. Declared props: name, dose, category, categoryColor, categoryTone, compartment, count, total, lowAt, outAt, schedule, paused, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillCard'] > JSXAttribute[name.name='categoryTone'] > Literal[value!=/^(?:leaf|rose|sky|apricot|honey|mauve|neutral)$/]",
        "message": "<PillCard> categoryTone must be one of 'leaf' | 'rose' | 'sky' | 'apricot' | 'honey' | 'mauve' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillSelectTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|compartment|color|count|selected|disabled|onToggle|key|ref|className|style|children)$/]",
        "message": "<PillSelectTile> doesn't accept that prop. Declared props: name, compartment, color, count, selected, disabled, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|formatValue|showTicks|key|ref|className|style|children)$/]",
        "message": "<RangeSlider> doesn't accept that prop. Declared props: value, min, max, step, onChange, formatValue, showTicks."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|fullWidth|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|footer|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, onClose, title, children, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='StockMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|total|lowAt|outAt|compact|style|key|ref|className|style|children)$/]",
        "message": "<StockMeter> doesn't accept that prop. Declared props: count, total, lowAt, outAt, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|description|disabled|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, description, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabBarItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|optional|value|onChange|placeholder|icon|suffix|type|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, optional, value, onChange, placeholder, icon, suffix, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|icon|visible|tone|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, icon, visible, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Toast> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|onBack|actions|large|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, eyebrow, onBack, actions, large."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
